  <owl:Class rdf:about="https://example.org/reality-ontology/3.1#RelationAssertion">
    <rdfs:label xml:lang="en">Relation Assertion</rdfs:label>
    <rdfs:comment xml:lang="en">A support class preserving the source fields of RelationAssertion.</rdfs:comment>
  </owl:Class>
  <owl:AnnotationProperty rdf:about="https://example.org/reality-ontology/3.1#record_RelationAssertion_source">
    <rdfs:label xml:lang="en">source</rdfs:label>
    <rdfs:comment xml:lang="en">Source-declared field of RelationAssertion: source.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/reality-ontology/3.1#RelationAssertion" />
    <ro:sourceDefinition>source class/entity</ro:sourceDefinition>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="https://example.org/reality-ontology/3.1#record_RelationAssertion_relation">
    <rdfs:label xml:lang="en">relation</rdfs:label>
    <rdfs:comment xml:lang="en">Source-declared field of RelationAssertion: relation.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/reality-ontology/3.1#RelationAssertion" />
    <ro:sourceDefinition>relation type</ro:sourceDefinition>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="https://example.org/reality-ontology/3.1#record_RelationAssertion_target">
    <rdfs:label xml:lang="en">target</rdfs:label>
    <rdfs:comment xml:lang="en">Source-declared field of RelationAssertion: target.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/reality-ontology/3.1#RelationAssertion" />
    <ro:sourceDefinition>target class/entity</ro:sourceDefinition>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="https://example.org/reality-ontology/3.1#record_RelationAssertion_strength">
    <rdfs:label xml:lang="en">strength</rdfs:label>
    <rdfs:comment xml:lang="en">Source-declared field of RelationAssertion: strength.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/reality-ontology/3.1#RelationAssertion" />
    <ro:sourceDefinition>fuzzy relation strength, usually [0,1] or [-1,1] for signed effects</ro:sourceDefinition>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="https://example.org/reality-ontology/3.1#record_RelationAssertion_confidence">
    <rdfs:label xml:lang="en">confidence</rdfs:label>
    <rdfs:comment xml:lang="en">Source-declared field of RelationAssertion: confidence.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/reality-ontology/3.1#RelationAssertion" />
    <ro:sourceDefinition>confidence in relation assessment [0,1]</ro:sourceDefinition>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="https://example.org/reality-ontology/3.1#record_RelationAssertion_time">
    <rdfs:label xml:lang="en">time</rdfs:label>
