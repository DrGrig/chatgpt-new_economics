<?xml version='1.0' encoding='UTF-8'?>
<rdf:RDF xmlns:dcterms="http://purl.org/dc/terms/" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:ro="https://example.org/reality-ontology/3.1#" xml:base="https://example.org/reality-ontology/3.1#">
  <owl:Ontology rdf:about="https://example.org/reality-ontology/3.1">
    <rdfs:label xml:lang="en">Reality Ontology</rdfs:label>
    <rdfs:comment xml:lang="en">OWL transfer of Reality Ontology 3.1. Structural axioms come from the equivalent JSON/YAML sources; the Russian PDF is used as corroborating documentation.</rdfs:comment>
    <owl:versionInfo>3.1</owl:versionInfo>
    <dcterms:source>ontology_master_v3_1.json</dcterms:source>
    <dcterms:source>ontology_master_v3_1.yaml</dcterms:source>
    <dcterms:source>ru_quantitative_labour_model_capital_debt_markets_V6_4.pdf, section 1.2</dcterms:source>
    <ro:sourceDefinition>{"absolute_need_intensity": {"symbol": "N_i_abs(t)", "meaning": "Unnormalized absolute intensity of NeedType i at time t.", "components": {"D_i": "deficit: distance between actual and desired/reference state", "H_i": "severity of consequences if unmet", "U_i": "urgency / time-to-harm", "P_i": "scale: number/share of affected entities", "Dep_i": "dependency of normal existence/functioning on satisfaction", "S_i": "subjective significance and revealed preference signals", "R_i": "irreversibility of consequences"}, "formula_status": "open", "working_form": "N_i_abs(t) = f(D_i, H_i, U_i, P_i, Dep_i, S_i, R_i)"}}</ro:sourceDefinition>
    <ro:sourceDefinition>{"confidence": {"symbol": "C_i(t)", "range": "[0,1]", "rule": "Confidence is stored separately from need intensity; low confidence does not imply low need."}}</ro:sourceDefinition>
    <ro:sourceDefinition>{"aggregation": {"dimensions": ["NeedType", "EntityGroup", "Location", "Time"], "working_tensor": "N_abs(i,g,l,t)", "rule": "NeedInstances are aggregated by NeedType and any selected grouping dimensions before normalization."}}</ro:sourceDefinition>
    <ro:sourceDefinition>{"normalized_matrix": {"symbol": "D_R(t)", "weight_symbol": "w_i,R(t)", "formula": "w_i,R(t) = N_i_abs(t) / sum_j N_j_abs(t)", "normalization_constraint": "sum_i w_i,R(t) = 1 when H_R(t) &gt; 0", "meaning": "Relative structure of currently unmet needs in reference system R."}}</ro:sourceDefinition>
    <ro:sourceDefinition>{"absolute_unmet_need_level": {"symbol": "H_R(t)", "formula": "H_R(t) = sum_i N_i_abs(t)", "meaning": "Scalar total absolute level of unmet needs.", "zero_case": {"condition": "H_R(t) = 0", "interpretation": "All represented needs are satisfied in the selected slice.", "D_R_status": "undefined/non-informative because normalization denominator is zero"}}}</ro:sourceDefinition>
    <ro:sourceDefinition>{"data_pipeline": ["ingest_data", "validate_schema", "map_to_entities", "update_states", "instantiate_or_update_need_instances", "compute_need_parameters", "compute_N_i_abs", "aggregate_by_need_type_group_location_time", "compute_H_R", "normalize_to_D_R_if_H_R_positive", "update_confidence", "record_provenance", "version_snapshot"]}</ro:sourceDefinition>
    <ro:transferNote>Fuzzy membership, confidence, temporal qualification, provenance records, and formulas are preserved as annotations. Their operational semantics require rules, datatype validation, temporal/provenance vocabularies, or an external calculation engine.</ro:transferNote>
  </owl:Ontology>
