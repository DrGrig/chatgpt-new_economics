    <rdfs:domain rdf:resource="https://example.org/reality-ontology/3.1#RelationAssertion" />
    <ro:sourceDefinition>time point or interval</ro:sourceDefinition>
  </owl:AnnotationProperty>
  <owl:AnnotationProperty rdf:about="https://example.org/reality-ontology/3.1#record_RelationAssertion_provenance">
    <rdfs:label xml:lang="en">provenance</rdfs:label>
    <rdfs:comment xml:lang="en">Source-declared field of RelationAssertion: provenance.</rdfs:comment>
    <rdfs:domain rdf:resource="https://example.org/reality-ontology/3.1#RelationAssertion" />
    <ro:sourceDefinition>source/method/version/history</ro:sourceDefinition>
  </owl:AnnotationProperty>
  <owl:Class rdf:about="https://example.org/reality-ontology/3.1#Entity">
    <rdfs:label xml:lang="en">Entity</rdfs:label>
    <rdfs:comment xml:lang="en">Any distinguishable object of reality represented as an identifiable unit.</rdfs:comment>
    <ro:sourceDescriptionRu xml:lang="ru">Любой различимый объект реальности, существующий или существовавший как идентифицируемая единица и представимый в онтологии.</ro:sourceDescriptionRu>
    <ro:sourceMethod>{"name": "create()", "description": "Создать новое представление Entity при наличии достаточных данных об идентичности."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "updateProperty()", "description": "Обновить значение свойства с сохранением времени, источника и предыдущего значения."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "updateState()", "description": "Связать Entity с новым State и сохранить историю состояний."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "classify() / reclassify()", "description": "Добавить, удалить или изменить степень принадлежности к классу."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "link() / unlink()", "description": "Создать или прекратить типизированную связь с другим Entity."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "merge()", "description": "Объединить записи, если доказано, что они описывают один и тот же объект."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "split()", "description": "Разделить Entity, если ранее единый объект оказался несколькими различимыми объектами."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "terminate()", "description": "Зафиксировать прекращение существования Entity."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "updateConfidence()", "description": "Пересчитать достоверность данных при появлении новых источников."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "traceProvenance()", "description": "Получить происхождение текущего состояния, свойства или классификации."}</ro:sourceMethod>
    <ro:sourceConstraint>{"name": "Unique ID", "rule": "ID каждого Entity уникален в пределах версии онтологии."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "Valid fuzzy range", "rule": "Для fuzzy-принадлежности и confidence: 0 ≤ value ≤ 1."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "Temporal consistency", "rule": "Если t_end задан, то t_birth ≤ t_end; состояние после t_end не создаётся без явного правила наследования/архивирования."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "Boundary defined", "rule": "Entity должен иметь определимую концептуальную границу, даже если она нечёткая или динамическая."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "Persistence rule", "rule": "Для продолжительно существующих объектов должен быть задан критерий тождества во времени."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "Existing references", "rule": "Components, State, Location и иные ссылки должны указывать на существующие или явно внешние Entity."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "No silent overwrite", "rule": "Обновление свойства не уничтожает предыдущее значение; создаётся история изменений."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "Provenance required", "rule": "Любое внешнее или вычисленное значение должно иметь source/method/version/time."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "Confidence semantics", "rule": "Низкая confidence не превращается автоматически в низкое value: значение и достоверность хранятся отдельно."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "Class consistency", "rule": "Специализированные классы не могут отменять базовые ограничения Entity без явного правила исключения."}</ro:sourceConstraint>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/reality-ontology/3.1#Resource">
    <rdfs:label xml:lang="en">Resource</rdfs:label>
    <rdfs:comment xml:lang="en">An entity treated as a resource in the source model.</rdfs:comment>
    <ro:sourceDescriptionRu xml:lang="ru">То, что может быть использовано для удовлетворения потребностей или как вход в процесс.</ro:sourceDescriptionRu>
    <rdfs:subClassOf rdf:resource="https://example.org/reality-ontology/3.1#Entity" />
    <ro:sourceMethod>{"name": "measureAvailability()", "description": "Оценить доступный объём в заданных времени и локации."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "allocate()", "description": "Закрепить часть ресурса за Entity/Process/Need."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "reserve()", "description": "Временно вывести объём из свободного распределения."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "transfer()", "description": "Изменить владельца/контролёра или место ресурса."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "consume()", "description": "Уменьшить доступное количество вследствие использования."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "transform()", "description": "Преобразовать ресурс в другой Resource/Product через Process."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "replenish()", "description": "Увеличить количество вследствие восполнения."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "estimateScarcity()", "description": "Рассчитать scarcity относительно доступности и потребности."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "matchNeed()", "description": "Определить пригодность ресурса для удовлетворения Need."}</ro:sourceMethod>
    <ro:sourceConstraint>{"name": "Non-negative quantity", "rule": "Quantity ≥ 0, кроме явно определённых бухгалтерских представлений, которые не являются физическим запасом."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "Unit required", "rule": "Количественный ресурс должен иметь единицу измерения."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "Conservation rules", "rule": "Для материальных/энергетических ресурсов преобразования должны соблюдать применимые законы сохранения."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "Allocation limit", "rule": "Сумма одновременных аллокаций не превышает доступное количество без явного механизма кредита/будущего ресурса."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "Access ≠ existence", "rule": "Наличие ресурса не означает его доступность; Availability и Accessibility различаются."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "Renewability bounded", "rule": "Renewability и связанные fuzzy-параметры лежат в [0,1]."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "Traceable transformation", "rule": "Transform должен ссылаться на Process и формировать происхождение результата."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "Temporal stock consistency", "rule": "Изменение запаса согласуется с inflow, outflow, transformation и measurement adjustments."}</ro:sourceConstraint>
    <ro:sourceRelation>locatedAt -&gt; Location</ro:sourceRelation>
    <ro:sourceRelation>ownedOrControlledBy -&gt; Entity</ro:sourceRelation>
    <ro:sourceRelation>usedBy -&gt; Process</ro:sourceRelation>
    <ro:sourceRelation>satisfies -&gt; Need</ro:sourceRelation>
    <ro:sourceRelation>transformedInto -&gt; Resource/Product</ro:sourceRelation>
    <ro:sourceRelation>regulatedBy -&gt; LegalConstruct</ro:sourceRelation>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/reality-ontology/3.1#Product">
    <rdfs:label xml:lang="en">Product</rdfs:label>
    <rdfs:comment xml:lang="en">An entity produced, modified, or used as a product.</rdfs:comment>
    <ro:sourceDescriptionRu xml:lang="ru">Результат процесса деятельности, обладающий функцией и потенциальной полезностью.</ro:sourceDescriptionRu>
    <rdfs:subClassOf rdf:resource="https://example.org/reality-ontology/3.1#Entity" />
    <ro:sourceMethod>{"name": "produce()", "description": "Создать экземпляр Product как выход Process."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "evaluateQuality()", "description": "Оценить качество по определённым метрикам."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "use()", "description": "Использовать продукт для функции/удовлетворения Need."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "degrade()", "description": "Обновить качество/срок полезности во времени."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "repair()", "description": "Восстановить часть функциональности через Process."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "reuse()", "description": "Повторно применить продукт без полного преобразования."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "recycle()", "description": "Преобразовать продукт в Resource/Product."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "retire()", "description": "Вывести продукт из использования."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "matchNeed()", "description": "Оценить соответствие конкретной Need."}</ro:sourceMethod>
    <ro:sourceConstraint>{"name": "Origin required", "rule": "Product должен иметь Producer/Process или иное объяснимое происхождение."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "Functional definition", "rule": "Для активного Product должна быть задана хотя бы одна функция или целевое применение."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "Composition references", "rule": "Компоненты, если заданы как Entity, должны существовать и иметь отношения partOf."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "Quality provenance", "rule": "Оценка Quality должна иметь метод и provenance."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "Lifetime consistency", "rule": "Возраст продукта не может превышать момент вывода/разрушения без статуса historical/archived."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "No double counting", "rule": "При превращении Product в Resource система должна предотвращать двойной учёт одного физического объекта."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "Need matching explicit", "rule": "Связь с Need требует критерия пригодности, а не только текстового совпадения."}</ro:sourceConstraint>
    <ro:sourceRelation>producedBy -&gt; Process</ro:sourceRelation>
    <ro:sourceRelation>producedByEntity -&gt; Entity</ro:sourceRelation>
    <ro:sourceRelation>contains -&gt; Entity</ro:sourceRelation>
    <ro:sourceRelation>satisfies -&gt; Need</ro:sourceRelation>
    <ro:sourceRelation>usedIn -&gt; Process</ro:sourceRelation>
    <ro:sourceRelation>locatedAt -&gt; Location</ro:sourceRelation>
    <ro:sourceRelation>ownedBy -&gt; Entity</ro:sourceRelation>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/reality-ontology/3.1#Infrastructure">
    <rdfs:label xml:lang="en">Infrastructure</rdfs:label>
    <rdfs:comment xml:lang="en">An entity providing capacity or support for processes.</rdfs:comment>
    <ro:sourceDescriptionRu xml:lang="ru">Долговременно существующая система, обеспечивающая возможность или пропускную способность других процессов.</ro:sourceDescriptionRu>
    <rdfs:subClassOf rdf:resource="https://example.org/reality-ontology/3.1#Entity" />
    <ro:sourceMethod>{"name": "provideCapacity()", "description": "Предоставить инфраструктурную мощность Process/Entity."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "measureUtilization()", "description": "Рассчитать текущую загрузку."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "maintain()", "description": "Провести обслуживание, изменив Wear/Reliability."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "repair()", "description": "Восстановить работоспособность после отказа."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "upgrade()", "description": "Изменить Capacity/Throughput/Function."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "decommission()", "description": "Вывести инфраструктуру из эксплуатации."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "detectBottleneck()", "description": "Определить ограничивающий элемент."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "estimateResilience()", "description": "Оценить устойчивость к заданному классу нарушений."}</ro:sourceMethod>
    <ro:sourceConstraint>{"name": "Capacity bound", "rule": "Utilization не должна превышать техническую Capacity без статуса overload."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "Dependency consistency", "rule": "Критические зависимости должны ссылаться на существующие Entity/Infrastructure/Resource."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "Maintenance trace", "rule": "Изменения Wear после обслуживания должны иметь Event/Process provenance."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "Coverage semantics", "rule": "Coverage задаётся географически, логически или по населению и не смешивается без явного преобразования."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "Operational status", "rule": "Capacity/Throughput активной эксплуатации не используются после decommission time."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "Reliability scale", "rule": "Fuzzy Reliability/Resilience хранятся в [0,1] с методом оценки."}</ro:sourceConstraint>
    <ro:sourceRelation>supports -&gt; Process</ro:sourceRelation>
    <ro:sourceRelation>serves -&gt; Entity/Location</ro:sourceRelation>
    <ro:sourceRelation>dependsOn -&gt; Infrastructure/Resource</ro:sourceRelation>
    <ro:sourceRelation>operatedBy -&gt; Entity</ro:sourceRelation>
    <ro:sourceRelation>locatedAt -&gt; Location</ro:sourceRelation>
    <ro:sourceRelation>satisfies -&gt; Need</ro:sourceRelation>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/reality-ontology/3.1#Location">
    <rdfs:label xml:lang="en">Location</rdfs:label>
    <rdfs:comment xml:lang="en">A spatial or contextual location represented by the ontology.</rdfs:comment>
    <ro:sourceDescriptionRu xml:lang="ru">Пространственный Entity, задающий место, границу и контекст существования других Entity.</ro:sourceDescriptionRu>
    <rdfs:subClassOf rdf:resource="https://example.org/reality-ontology/3.1#Entity" />
    <ro:sourceMethod>{"name": "contains()", "description": "Проверить пространственное включение Entity."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "locate()", "description": "Определить положение Entity относительно Location."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "measureDistance()", "description": "Рассчитать расстояние по определённой метрике."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "measureAccessibility()", "description": "Оценить достижимость с учётом сети, времени и ограничений."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "aggregateState()", "description": "Агрегировать состояния Entity внутри территории."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "updateBoundary()", "description": "Изменить геометрию/границы с versioning."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "estimateCapacity()", "description": "Оценить допустимую нагрузку/вместимость."}</ro:sourceMethod>
    <ro:sourceConstraint>{"name": "Geometry validity", "rule": "Boundary должна быть геометрически валидной для выбранной модели пространства."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "Hierarchy consistency", "rule": "ParentLocation не может создавать циклическую пространственную иерархию."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "Temporal boundary", "rule": "Изменение границы требует времени действия версии."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "Coordinate reference", "rule": "Координаты должны указывать систему отсчёта/CRS или иной логический координатный контекст."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "Contained entity time", "rule": "Пространственное включение относится к конкретному времени/интервалу."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "Population provenance", "rule": "Агрегированные показатели населения должны иметь дату и источник."}</ro:sourceConstraint>
    <ro:sourceRelation>contains -&gt; Entity</ro:sourceRelation>
    <ro:sourceRelation>partOf -&gt; Location</ro:sourceRelation>
    <ro:sourceRelation>connectedTo -&gt; Location</ro:sourceRelation>
    <ro:sourceRelation>governedBy -&gt; LegalConstruct</ro:sourceRelation>
    <ro:sourceRelation>hasInfrastructure -&gt; Infrastructure</ro:sourceRelation>
    <ro:sourceRelation>containsResource -&gt; Resource</ro:sourceRelation>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/reality-ontology/3.1#Information">
    <rdfs:label xml:lang="en">Information</rdfs:label>
    <rdfs:comment xml:lang="en">Information represented as an entity with provenance and quality characteristics.</rdfs:comment>
    <ro:sourceDescriptionRu xml:lang="ru">Содержательно интерпретируемый объект данных/знания, который может храниться, передаваться и использоваться.</ro:sourceDescriptionRu>
    <rdfs:subClassOf rdf:resource="https://example.org/reality-ontology/3.1#Entity" />
    <ro:sourceMethod>{"name": "createVersion()", "description": "Создать новую версию без уничтожения предыдущей."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "validate()", "description": "Проверить структуру, типы и логические правила."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "verifySource()", "description": "Проверить доступную цепочку происхождения."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "updateConfidence()", "description": "Пересчитать confidence при новых доказательствах."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "derive()", "description": "Создать производный информационный объект с указанием метода."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "linkSemantically()", "description": "Добавить типизированную семантическую связь."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "restrictAccess()", "description": "Изменить правила доступа."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "archive()", "description": "Перевести устаревшую версию в архивный статус."}</ro:sourceMethod>
    <ro:sourceConstraint>{"name": "Version immutability", "rule": "Опубликованная версия не перезаписывается; исправление создаёт новую версию."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "Source traceability", "rule": "Производная информация должна ссылаться на исходные данные и метод."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "Access compliance", "rule": "Доступ и распространение должны соответствовать LegalConstruct."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "Confidence separated", "rule": "Reliability источника, Validity содержания и Confidence оценки не отождествляются."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "No provenance loss", "rule": "Трансформация не должна удалять происхождение входных данных."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "Timestamp required", "rule": "Для меняющейся информации должен быть указан момент актуальности."}</ro:sourceConstraint>
    <ro:sourceRelation>derivedFrom -&gt; Information</ro:sourceRelation>
    <ro:sourceRelation>generatedBy -&gt; Entity/Process</ro:sourceRelation>
    <ro:sourceRelation>describes -&gt; Entity/State/Event</ro:sourceRelation>
    <ro:sourceRelation>usedBy -&gt; Process</ro:sourceRelation>
    <ro:sourceRelation>regulatedBy -&gt; LegalConstruct</ro:sourceRelation>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/reality-ontology/3.1#LegalConstruct">
    <rdfs:label xml:lang="en">LegalConstruct</rdfs:label>
    <rdfs:comment xml:lang="en">A legal construct governing rights, duties, restrictions, or authorization.</rdfs:comment>
    <ro:sourceDescriptionRu xml:lang="ru">Созданная институциональными правилами абстрактная конструкция прав, обязательств или ограничений.</ro:sourceDescriptionRu>
    <rdfs:subClassOf rdf:resource="https://example.org/reality-ontology/3.1#Entity" />
    <ro:sourceMethod>{"name": "activate()", "description": "Перевести в действующее состояние при выполнении условий."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "terminate()", "description": "Прекратить действие согласно условиям."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "transfer()", "description": "Изменить RightsHolder/ObligatedParty при допустимой передаваемости."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "enforce()", "description": "Запустить предусмотренный механизм исполнения."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "verifyValidity()", "description": "Проверить действительность во времени и юрисдикции."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "amend()", "description": "Создать новую версию условий с историей изменений."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "attachCollateral()", "description": "Связать обеспечение."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "resolvePriority()", "description": "Определить приоритет конкурирующих прав по заданному правилу."}</ro:sourceMethod>
    <ro:sourceConstraint>{"name": "Jurisdiction required", "rule": "Для правовых эффектов должна быть определена юрисдикция или система правил."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "Temporal validity", "rule": "Действие ограничено ValidityStart/ValidityEnd и условиями."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "Existing parties", "rule": "RightsHolder, ObligatedParty и ObjectOfRight должны быть идентифицируемыми Entity."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "Transfer only if allowed", "rule": "Transfer возможен только если Transferability допускает его."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "No silent amendment", "rule": "Изменение условий создаёт новую версию/историю."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "Authority provenance", "rule": "Действительность должна быть связана с источником полномочий/правил."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "Conflict resolution", "rule": "Конфликтующие конструкции требуют явного правила Priority или неопределённого статуса."}</ro:sourceConstraint>
    <ro:sourceRelation>grantsRightTo -&gt; Entity</ro:sourceRelation>
    <ro:sourceRelation>imposesObligationOn -&gt; Entity</ro:sourceRelation>
    <ro:sourceRelation>appliesTo -&gt; Entity/Process/Resource</ro:sourceRelation>
    <ro:sourceRelation>issuedBy -&gt; Entity</ro:sourceRelation>
    <ro:sourceRelation>securedBy -&gt; Entity/Resource</ro:sourceRelation>
    <ro:sourceRelation>governedIn -&gt; Location</ro:sourceRelation>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/reality-ontology/3.1#State">
    <rdfs:label xml:lang="en">State</rdfs:label>
    <rdfs:comment xml:lang="en">A time-dependent state of an entity or system.</rdfs:comment>
    <ro:sourceDescriptionRu xml:lang="ru">Формальное описание значений релевантных переменных Entity в момент или интервал времени.</ro:sourceDescriptionRu>
    <rdfs:subClassOf rdf:resource="https://example.org/reality-ontology/3.1#Entity" />
    <ro:sourceMethod>{"name": "observe()", "description": "Создать State на основании наблюдений/измерений."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "compare()", "description": "Сопоставить два состояния одного совместимого объекта/параметра."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "computeDeviation()", "description": "Рассчитать отклонение от Reference/Desired."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "estimateTrend()", "description": "Определить тренд по последовательности State."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "detectThresholdCrossing()", "description": "Зафиксировать переход заданного порога."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "interpolate()", "description": "Оценить состояние между наблюдениями с явной неопределённостью."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "aggregate()", "description": "Сформировать агрегированное состояние группы/Location."}</ro:sourceMethod>
    <ro:sourceConstraint>{"name": "Subject required", "rule": "State всегда относится к одному или явно определённому агрегату Entity."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "Timestamp required", "rule": "State без временной привязки недопустим."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "Dimension consistency", "rule": "Сравниваемые значения должны быть размерностно совместимы или иметь преобразование."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "No future fact", "rule": "Прогноз не маркируется как наблюдаемое состояние; требуется отдельный status/method."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "Confidence required for inferred", "rule": "Интерполированные/вычисленные значения обязаны иметь confidence и method."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "Immutable observation", "rule": "Зафиксированное наблюдение не перезаписывается; корректировка создаёт новую запись."}</ro:sourceConstraint>
    <ro:sourceRelation>stateOf -&gt; Entity</ro:sourceRelation>
    <ro:sourceRelation>measuredBy -&gt; Entity/Process</ro:sourceRelation>
    <ro:sourceRelation>derivedFrom -&gt; Information</ro:sourceRelation>
    <ro:sourceRelation>changedBy -&gt; Event/Process</ro:sourceRelation>
    <ro:sourceRelation>comparedTo -&gt; State</ro:sourceRelation>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/reality-ontology/3.1#Event">
    <rdfs:label xml:lang="en">Event</rdfs:label>
    <rdfs:comment xml:lang="en">An occurrence that may involve entities and change states.</rdfs:comment>
    <ro:sourceDescriptionRu xml:lang="ru">Локализованный во времени факт, приводящий или соответствующий изменению состояния одного или нескольких Entity.</ro:sourceDescriptionRu>
    <rdfs:subClassOf rdf:resource="https://example.org/reality-ontology/3.1#Entity" />
    <ro:sourceMethod>{"name": "record()", "description": "Зафиксировать произошедшее событие и evidence."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "predict()", "description": "Создать прогнозируемый Event с probability и методом."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "linkCause()", "description": "Связать возможную/подтверждённую причину с типом уверенности."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "applyStateChange()", "description": "Сформировать StateAfter на основании подтверждённого изменения."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "assessMagnitude()", "description": "Оценить масштаб по заданной шкале."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "reverse()", "description": "Зафиксировать обратное действие, если физически/логически возможно."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "aggregateEvents()", "description": "Объединить серию событий в более крупное событие без потери исходных ссылок."}</ro:sourceMethod>
    <ro:sourceConstraint>{"name": "Temporal order", "rule": "StartTime ≤ EndTime, если EndTime задан."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "Observed vs predicted", "rule": "Произошедшее и прогнозируемое событие имеют разные статусы."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "Evidence provenance", "rule": "Observed Event должен иметь evidence/source или явно низкую confidence."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "Cause ≠ correlation", "rule": "Связь cause должна отличаться от temporalAssociation/correlation."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "State consistency", "rule": "StateAfter должен согласовываться с StateBefore + StateChange в пределах модели."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "Participants exist", "rule": "Участники и AffectedEntities должны быть Entity."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "No duplicate event", "rule": "Дедупликация должна учитывать время, место, участников и provenance."}</ro:sourceConstraint>
    <ro:sourceRelation>occursAt -&gt; Location</ro:sourceRelation>
    <ro:sourceRelation>involves -&gt; Entity</ro:sourceRelation>
    <ro:sourceRelation>changes -&gt; State</ro:sourceRelation>
    <ro:sourceRelation>causedBy -&gt; Event/Process/Entity</ro:sourceRelation>
    <ro:sourceRelation>evidencedBy -&gt; Information</ro:sourceRelation>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/reality-ontology/3.1#Process">
    <rdfs:label xml:lang="en">Process</rdfs:label>
    <rdfs:comment xml:lang="en">A process using inputs and producing or changing outputs and states.</rdfs:comment>
    <ro:sourceDescriptionRu xml:lang="ru">Протяжённое во времени преобразование входов в выходы и/или изменение состояний.</ro:sourceDescriptionRu>
    <rdfs:subClassOf rdf:resource="https://example.org/reality-ontology/3.1#Entity" />
    <ro:sourceMethod>{"name": "start()", "description": "Перевести процесс в active при выполнении предусловий."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "pause() / resume()", "description": "Приостановить/возобновить, если тип процесса это допускает."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "stop()", "description": "Завершить процесс."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "consumeInputs()", "description": "Учесть использование входов/ресурсов."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "produceOutputs()", "description": "Создать выходные Product/Resource/Information/State."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "measureEfficiency()", "description": "Рассчитать эффективность по определённой функции."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "detectBottleneck()", "description": "Определить ограничивающий фактор."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "adjustControl()", "description": "Изменить управляющий параметр с записью причины."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "simulate()", "description": "Рассчитать прогноз результата без изменения фактического состояния."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "audit()", "description": "Восстановить цепочку inputs → transformations → outputs."}</ro:sourceMethod>
    <ro:sourceConstraint>{"name": "Input existence", "rule": "Все обязательные Inputs должны существовать или быть явно виртуальными/прогнозируемыми."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "Temporal consistency", "rule": "StartTime ≤ EndTime; Duration согласуется с интервалом."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "Resource accounting", "rule": "Потребление ресурсов должно отражаться в их State/Quantity."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "Output provenance", "rule": "Каждый Output имеет ссылку на Process и использованные Inputs."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "Simulation separation", "rule": "Результат simulate не изменяет фактические State без отдельного commit/action."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "Capacity bound", "rule": "Throughput &gt; Capacity требует overload state или пересмотра Capacity."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "Algorithm version", "rule": "Если результат зависит от Rules/Algorithm, должна быть зафиксирована версия."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "No hidden side effects", "rule": "Известные SideEffects/Externalities сохраняются как часть результата, а не игнорируются."}</ro:sourceConstraint>
    <ro:sourceRelation>uses -&gt; Resource/Information</ro:sourceRelation>
    <ro:sourceRelation>produces -&gt; Product/Resource/Information</ro:sourceRelation>
    <ro:sourceRelation>executedBy -&gt; Entity</ro:sourceRelation>
    <ro:sourceRelation>occursAt -&gt; Location</ro:sourceRelation>
    <ro:sourceRelation>changes -&gt; State</ro:sourceRelation>
    <ro:sourceRelation>supportedBy -&gt; Infrastructure</ro:sourceRelation>
    <ro:sourceRelation>regulatedBy -&gt; LegalConstruct</ro:sourceRelation>
    <ro:sourceRelation>satisfies -&gt; Need</ro:sourceRelation>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/reality-ontology/3.1#Need">
    <rdfs:label xml:lang="en">Need</rdfs:label>
    <rdfs:comment xml:lang="en">A computed structure describing a significant gap between actual and desired or reference state.</rdfs:comment>
    <ro:sourceDescriptionRu xml:lang="ru">Вычисляемая структура, описывающая значимый разрыв между фактическим и желаемым/референтным состоянием носителя или связанного с ним Entity.</ro:sourceDescriptionRu>
    <rdfs:subClassOf rdf:resource="https://example.org/reality-ontology/3.1#Entity" />
    <ro:sourceMethod>{"name": "detect()", "description": "Создать Need при наличии определяемого значимого разрыва состояния."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "measureDeficit()", "description": "Рассчитать D по совместимым Actual/Desired/Reference State."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "estimateUrgency()", "description": "Оценить скорость/тяжесть последствий неудовлетворения."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "estimateSignificance()", "description": "Оценить значимость по принятой модели."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "estimateSatisfiability()", "description": "Оценить возможность удовлетворения при известных ресурсах/технологиях."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "matchResources()", "description": "Найти Resource/Product/Process, способные уменьшить дефицит."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "measureSatisfaction()", "description": "Оценить изменение Need после интервенции/процесса."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "updateWeight()", "description": "Передать параметры в алгоритм расчёта q_i и w_i."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "resolveOverlap()", "description": "Выявить дублирующие/вложенные Need."}</ro:sourceMethod>
    <ro:sourceMethod>{"name": "detectConflict()", "description": "Определить конфликт между потребностями и его тип."}</ro:sourceMethod>
    <ro:sourceConstraint>{"name": "Holder required", "rule": "Need должна иметь Holder или явно определённый коллектив/экосистемный носитель."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "State comparability", "rule": "ActualState и Desired/ReferenceState должны быть сопоставимы или иметь явную функцию преобразования."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "No negative deficit by default", "rule": "D ≥ 0; превышение желаемого уровня описывается Saturation/Surplus, если модель не задаёт иное."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "Evidence separation", "rule": "SubjectiveAssessment и ObjectiveIndicators хранятся раздельно и могут иметь разные веса."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "No direct weight assignment", "rule": "w(t) не вводится вручную без provenance; он является результатом согласованного алгоритма."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "Normalization external", "rule": "Σw_i=1 относится к выбранному срезу матрицы D(t), а не к отдельной Need."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "Overlap control", "rule": "Пересекающиеся Need должны иметь отношения parent/child/overlap, чтобы избежать двойного счёта."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "Temporal update", "rule": "Изменение ActualState должно инициировать пересчёт зависимых параметров Need согласно правилам обновления."}</ro:sourceConstraint>
    <ro:sourceConstraint>{"name": "Confidence propagation", "rule": "Неопределённость исходных State/Indicators должна учитываться в Confidence параметров Need."}</ro:sourceConstraint>
    <ro:sourceRelation>heldBy -&gt; Entity</ro:sourceRelation>
    <ro:sourceRelation>targets -&gt; Entity/State</ro:sourceRelation>
    <ro:sourceRelation>definedBy -&gt; State</ro:sourceRelation>
    <ro:sourceRelation>satisfiedBy -&gt; Resource/Product/Process/Infrastructure</ro:sourceRelation>
    <ro:sourceRelation>conflictsWith -&gt; Need</ro:sourceRelation>
    <ro:sourceRelation>complements -&gt; Need</ro:sourceRelation>
    <ro:sourceRelation>partOf -&gt; Need</ro:sourceRelation>
    <ro:sourceRelation>observedIn -&gt; Location</ro:sourceRelation>
  </owl:Class>
  <owl:Class rdf:about="https://example.org/reality-ontology/3.1#Subject">
    <rdfs:label xml:lang="en">Subject</rdfs:label>
    <rdfs:comment xml:lang="en">A computed classification of an Entity; it is not asserted as a subclass because the source defines a computation rather than an OWL class axiom.</rdfs:comment>
    <ro:transferNote>No rdfs:subClassOf axiom is asserted: classification requires an external rule or computation.</ro:transferNote>
    <ro:computedCriterion>B: устойчивость границы и идентичности</ro:computedCriterion>
    <ro:computedCriterion>P: получение информации о среде/собственном состоянии</ro:computedCriterion>
    <ro:computedCriterion>D: выбор между альтернативными реакциями</ro:computedCriterion>
    <ro:computedCriterion>A: способность изменять состояние/среду</ro:computedCriterion>
    <ro:computedCriterion>F: обратная связь</ro:computedCriterion>
    <ro:computedProfile>E: subjective experience</ro:computedProfile>
    <ro:computedProfile>A: self-awareness / functional self-model</ro:computedProfile>
    <ro:computedProfile>M: memory</ro:computedProfile>
    <ro:computedProfile>L: learning</ro:computedProfile>
    <ro:computedProfile>G: autonomous goal formation</ro:computedProfile>
    <ro:computedProfile>C: creative agency</ro:computedProfile>
    <ro:computedProfile>R: decision autonomy/responsibility</ro:computedProfile>
    <ro:sourceFormula>S_i = [[v_E,...,v_R],[c_E,...,c_R]]</ro:sourceFormula>
  </owl:Class>
